# Maser Media contact form -> Google Calendar
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Production / Preview values live in Vercel project settings, not in this file.
# Step-by-step setup is in docs/CONTACT_FORM_SETUP.md.

# OAuth 2.0 Client created in Google Cloud Console (Web application type).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Refresh token minted via OAuth Playground while authenticated as the
# Google account whose calendar should receive bookings.
# Scope required: https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_REFRESH_TOKEN=

# The destination inbox / calendar owner. Must match the Google account that
# consented to the OAuth app above.
CONTACT_TO_EMAIL=masermediagroup@gmail.com
